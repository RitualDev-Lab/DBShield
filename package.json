{
  "name": "@ritualdev-lab/dbshield",
  "version": "0.1.0",
  "description": "Safety-first Database Guardrail & Sandboxing MCP Server for AI Coding Agents (Cursor, Claude Desktop, Antigravity). Protects databases from unconstrained mutations, drops, locks, and PII leaks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dbshield": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "database-security",
    "sql-guardrail",
    "cursor",
    "claude-desktop",
    "ast-parser",
    "sandboxing",
    "dry-run",
    "pii-masking",
    "postgres",
    "sqlite",
    "mysql"
  ],
  "author": "RitualDev Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/DBShield.git"
  },
  "bugs": {
    "url": "https://github.com/RitualDev-Lab/DBShield/issues"
  },
  "homepage": "https://github.com/RitualDev-Lab/DBShield#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "node-sql-parser": "^5.3.7",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
