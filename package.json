{
  "name": "@ritualdev-lab/dbshield",
  "version": "0.2.1",
  "mcpName": "io.github.RitualDev-Lab/dbshield",
  "description": "Safety-first Database Guardrail & Sandboxing MCP Server for AI Coding Agents (Cursor, Claude Desktop, Antigravity). Protects databases from unconstrained mutations, drops, locks, and PII leaks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "icon": "assets/logo.png",
  "bin": {
    "dbshield": "dist/cli.js",
    "dbs": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "action.yml",
    "assets/logo.png",
    "THREAT_MODEL.md",
    "GUIDE.md",
    "ENTERPRISE_SLA.md",
    "SOC2_ISO27001_COMPLIANCE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test",
    "benchmark": "python benchmarks/proxy_overhead_benchmark.py",
    "prepublishOnly": "npm run build && npm test && npm pack --dry-run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "keywords": [
    "ai-agent-security",
    "mcp-server",
    "sandbox",
    "developer-tools",
    "cursor-ide",
    "windsurf-ai",
    "llm-security",
    "database-security",
    "sql-guardrail",
    "wire-proxy",
    "postgres",
    "sqlite",
    "mysql"
  ],
  "author": "RitualDev Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/DBShield.git"
  },
  "bugs": {
    "url": "https://github.com/RitualDev-Lab/DBShield/issues"
  },
  "homepage": "https://ritualdev.in/dbshield/",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "node-sql-parser": "^5.3.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "fast-uri": "^3.1.9"
    }
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9"
  },
  "resolutions": {
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
